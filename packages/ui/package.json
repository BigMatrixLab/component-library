  "scripts": {
    "build": "node scripts/gen-exports.mjs && npm run build:js && npm run build:types && node scripts/fix-extensions.mjs && npm run build:css",
    "build:js": "tsup",
    "build:types": "tsc -p tsconfig.build.json",
    "build:css": "tailwindcss -i src/styles/styles.css -o dist/styles.css --minify",
    "gen:exports": "node scripts/gen-exports.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
